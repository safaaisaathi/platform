rules_version = '2';
// =====================================================================
// PHASE 1. The loose rules. This is what is deployed today.
// =====================================================================
//
// The rule here is only "is somebody signed in". That is the ANONYMOUS
// user. Every app signs in anonymously today, so every app works.
//
// This file stays deployed until all three apps have adopted CHG-0003 and
// are signing in with a CUSTOM TOKEN that carries their claims. The
// replacement is firestore.strict.rules in this same folder.
//
// WHY THE REPLACEMENT IS A SEPARATE FILE AND NOT A REWRITE OF THIS ONE.
// The rules tighten LAST. If the strict rules were deployed while an app
// still signed in anonymously, every write would be denied and the failure
// would look like "the screen is empty", not "you are not authorised".
// A separate file means the switch is one deploy, on a day when every app
// is ready, instead of a rule that changes under the apps' feet.
//
// The switch procedure is in README.md, section 5.
// The three identities and their claims are in firestore.strict.rules.
// The old driver-app dev rules. They were loose only where the driver flows
// needed it during the dev stage. They are replaced, not tightened in place.
// See firestore.strict.rules for the claims-based rules and README.md section 5
// for the switch procedure.
service cloud.firestore {
  match /databases/{database}/documents {
    // READS: only the seeded public collections, only signed-in app users.
    match /vans/{vanId} {
      allow read: if request.auth != null;
      // 0.8 write scope: the driver's own van writes only (location /
      // status / battery / currentTripId), nothing else. `depot` (ruling
      // #29) is deliberately absent: it is an ADMIN tag, written from the
      // console / PRD-3 panel, never by the driver app.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['lastLocation', 'status', 'batteryPct', 'currentTripId']);
    }
    match /routes/{routeId} {
      allow read: if request.auth != null;
    }
    match /wards/{wardId} {
      allow read: if request.auth != null;
    }
    match /notices/{noticeId} {
      allow read: if request.auth != null;
    }
    // 0.16: driver identity, keyed by the driver code (AB-1234). Read by
    // the start-shift flow; writes are admin-only (console / PRD-3 panel).
    match /drivers/{code} {
      allow read: if request.auth != null;
    }
    match /trips/{tripId} {
      allow read: if request.auth != null;
      // Trips are created by the start-shift flow and updated while a
      // shift is live (wardsDone / alertedWardIds / gpsTrail / endedAt).
      allow create, update: if request.auth != null;
    }
    match /complaints/{complaintId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      // D4 (F-D6, PRD-2 §3 "Pending Reports"): "Will Revisit" sets
      // status = assigned, "Done" sets status = resolved + resolvedAt.
      // Without `allow update` every D4 button failed in production.
      allow update: if request.auth != null;
    }
  }
}
